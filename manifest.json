{
  "manifest_version": 3,
  "name": "CompactDocs",
  "version": "1.1.0",
  "description": "Reclaim Google Docs editing space by collapsing document tabs and hiding the right side-panel rail.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CompactDocs settings"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/document/d/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "compact.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
